# =============================================================================
# EchoBreaker Configuration
# =============================================================================
# Provider: "azure" (fast, cloud) or "local" (private, offline)
PROVIDER=azure

# --- Azure OpenAI (required when PROVIDER=azure) ---
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-54-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Azure Speech (required when PROVIDER=azure) ---
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=germanywestcentral

# --- Local Fallback (used when PROVIDER=local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
